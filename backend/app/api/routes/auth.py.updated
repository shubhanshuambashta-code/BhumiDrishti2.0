from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session
from app.db import get_db
from app.schemas import UserCreate, Token, UserOut
from app.core.security import hash_password, create_access_token, verify_password
from app import models
from datetime import timedelta

router = APIRouter()

@router.post('/register', response_model=UserOut)
def register(user: UserCreate, db: Session = Depends(get_db)):
    existing = db.query(models.User).filter(models.User.username == user.username).first()
    if existing:
        raise HTTPException(status_code=400, detail='User exists')
    hashed = hash_password(user.password)
    u = models.User(username=user.username, hashed_password=hashed, role=user.role)
    db.add(u)
    db.commit()
    return {'username': u.username, 'role': u.role}

@router.post('/login', response_model=Token)
def login(form_data: UserCreate, db: Session = Depends(get_db)):
    u = db.query(models.User).filter(models.User.username == form_data.username).first()
    if not u or not verify_password(form_data.password, u.hashed_password):
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail='Invalid credentials')
    access_token = create_access_token(data={"sub": u.username, "role": u.role})
    return {"access_token": access_token, "token_type": "bearer"}
