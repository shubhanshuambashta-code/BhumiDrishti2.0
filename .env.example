# Environment example for BHUMIDRISHTI

# FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database (Postgres)
POSTGRES_USER=bhumi_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bhumidrishti_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://bhumi_user:changeme@db:5432/bhumidrishti_db

# JWT
JWT_SECRET_KEY=replace_this_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML
MODEL_PATH=ml/models/model_v1.joblib

# Other
REDIS_URL=redis://redis:6379/0

