from fastapi import APIRouter, Depends, HTTPException, UploadFile, File
from sqlalchemy.orm import Session
from typing import List
from pydantic import BaseModel
from app.db import get_db
from app.api.deps import get_current_user, require_role
from app.services.tasks import create_task, list_tasks, update_task_status, claim_task, tasks_for_inbox, add_comment, list_comments, save_attachment, list_attachments, get_attachment_path
from fastapi.responses import FileResponse

router = APIRouter()

class TaskCreate(BaseModel):
    title: str
    description: str
    assigned_role: str = None
    assigned_user: str = None
    priority: str = 'Medium'
    due_date: str = None

@router.post('/projects/{project_id}/tasks')
def api_create_task(project_id: str, payload: TaskCreate, db: Session = Depends(get_db), user = Depends(get_current_user)):
    t = create_task(db, username=user.username, project_id=project_id, title=payload.title, description=payload.description, assigned_role=payload.assigned_role, assigned_user=payload.assigned_user, priority=payload.priority, due_date=payload.due_date)
    return {'task': {'id': t.id, 'title': t.title, 'status': t.status}}

@router.get('/projects/{project_id}/tasks')
def api_list_tasks(project_id: str, db: Session = Depends(get_db), user = Depends(get_current_user)):
    rows = list_tasks(db, project_id)
    return {'tasks': [ {'id': r.id, 'title': r.title, 'status': r.status, 'assigned_role': r.assigned_role, 'assigned_user': r.assigned_user, 'priority': r.priority, 'due_date': r.due_date, 'created_at': r.created_at.isoformat()} for r in rows ]}

@router.post('/tasks/{task_id}/status')
def api_update_task(task_id: int, payload: dict, db: Session = Depends(get_db), user = Depends(get_current_user)):
    status = payload.get('status')
    if not status:
        raise HTTPException(status_code=400, detail='status required')
    t = update_task_status(db, username=user.username, task_id=task_id, status=status)
    if not t:
        raise HTTPException(status_code=404, detail='Task not found')
    return {'task': {'id': t.id, 'status': t.status}}

@router.post('/tasks/{task_id}/claim')
def api_claim_task(task_id: int, db: Session = Depends(get_db), user = Depends(get_current_user)):
    t = claim_task(db, username=user.username, task_id=task_id)
    if not t:
        raise HTTPException(status_code=404, detail='Task not found')
    return {'task': {'id': t.id, 'assigned_user': t.assigned_user, 'status': t.status}}

@router.get('/tasks/inbox')
def api_tasks_inbox(db: Session = Depends(get_db), user = Depends(get_current_user)):
    rows = tasks_for_inbox(db, username=user.username, role=user.role)
    return {'tasks': [ {'id': r.id, 'title': r.title, 'status': r.status, 'assigned_role': r.assigned_role, 'assigned_user': r.assigned_user, 'priority': r.priority, 'due_date': r.due_date, 'project_id': r.project_id, 'created_at': r.created_at.isoformat()} for r in rows ]}

# Comments
@router.post('/tasks/{task_id}/comment')
def api_add_comment(task_id: int, payload: dict, db: Session = Depends(get_db), user = Depends(get_current_user)):
    comment = payload.get('comment')
    parent_id = payload.get('parent_id')
    if not comment:
        raise HTTPException(status_code=400, detail='comment required')
    c = add_comment(db, username=user.username, task_id=task_id, comment=comment, parent_id=parent_id)
    return {'comment': {'id': c.id, 'comment': c.comment, 'username': c.username, 'parent_id': c.parent_id, 'created_at': c.created_at.isoformat()}}

@router.get('/tasks/{task_id}/comments')
def api_list_comments(task_id: int, db: Session = Depends(get_db), user = Depends(get_current_user)):
    rows = list_comments(db, task_id)
    return {'comments': rows}

# Attachments
@router.post('/tasks/{task_id}/attachments')
def api_upload_attachment(task_id: int, file: UploadFile = File(...), db: Session = Depends(get_db), user = Depends(get_current_user)):
    a = save_attachment(db, username=user.username, task_id=task_id, upload_file=file)
    return {'attachment': {'id': a.id, 'filename': a.filename, 'original_name': a.original_name, 'uploaded_by': a.uploaded_by, 'uploaded_at': a.uploaded_at.isoformat()}}

@router.get('/tasks/{task_id}/attachments')
def api_list_attachments(task_id: int, db: Session = Depends(get_db), user = Depends(get_current_user)):
    rows = list_attachments(db, task_id)
    return {'attachments': [ {'id': r.id, 'filename': r.filename, 'original_name': r.original_name, 'uploaded_by': r.uploaded_by, 'uploaded_at': r.uploaded_at.isoformat()} for r in rows ]}

@router.get('/tasks/attachments/{filename}')
def api_get_attachment(filename: str, db: Session = Depends(get_db), user = Depends(get_current_user)):
    p = get_attachment_path(filename)
    if not p:
        raise HTTPException(status_code=404, detail='File not found')
    return FileResponse(p, filename=filename)
