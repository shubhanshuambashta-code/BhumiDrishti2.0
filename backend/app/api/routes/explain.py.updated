from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from app.db import get_db
from app.api.deps import get_current_user
from app.services.explain import generate_shap_explanation, simulate_intervention
from pydantic import BaseModel

router = APIRouter()

@router.get('/projects/{project_id}/explain-enhanced')
def api_explain_enhanced(project_id: str, db: Session = Depends(get_db), user = Depends(get_current_user)):
    data = generate_shap_explanation(project_id)
    return data

class InterventionPayload(BaseModel):
    pending_approvals: int = 0
    compensation_pending_percentage: float = 0.0
    possession_percentage: float = 0.0
    legal_disputes: int = 0

@router.post('/projects/{project_id}/intervene')
def api_intervene(project_id: str, payload: InterventionPayload, db: Session = Depends(get_db), user = Depends(get_current_user)):
    # For now this is a deterministic heuristic simulator
    res = simulate_intervention(project_id, payload.dict())
    return res
