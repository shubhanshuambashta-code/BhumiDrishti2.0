from fastapi import APIRouter, HTTPException, Depends
from sqlalchemy.orm import Session
from app.db import get_db, engine
from app.models import Project
from app.schemas import ProjectOut
from app.services.predict import predict_project
from app.services.shap_service import explain_project_shap

router = APIRouter()

@router.get('/projects')
def list_projects(limit: int = 50, offset: int = 0, db: Session = Depends(get_db)):
    q = db.query(Project).limit(limit).offset(offset).all()
    return {"total": len(q), "rows": [ProjectOut.from_orm(r).dict() for r in q]}

@router.get('/projects/{project_id}')
def get_project(project_id: str, db: Session = Depends(get_db)):
    p = db.query(Project).filter(Project.project_id == project_id).first()
    if not p:
        raise HTTPException(status_code=404, detail='Project not found')
    result = ProjectOut.from_orm(p).dict()
    result['_demo_data_notice'] = 'DEMONSTRATION DATA - Not official government data'
    return result

@router.post('/predict')
def predict(payload: dict):
    return predict_project(payload)

@router.get('/projects/{project_id}/explain')
def explain_project(project_id: str, db: Session = Depends(get_db)):
    p = db.query(Project).filter(Project.project_id == project_id).first()
    if not p:
        raise HTTPException(status_code=404, detail='Project not found')
    # convert to dict
    row = {c.name: getattr(p, c.name) for c in p.__table__.columns}
    explanation = explain_project_shap(row)
    return explanation
